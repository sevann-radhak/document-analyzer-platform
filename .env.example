# =============================================================================
# Document Analyzer Platform - Environment Variables
# =============================================================================
# Copy this file to .env and update with your actual values
# cp .env.example .env

# =============================================================================
# Database Configuration
# =============================================================================
# Option 1: Complete connection string (full control)
# DATABASE_URL=mssql+pyodbc://username:password@server/database_name?driver=ODBC+Driver+17+for+SQL+Server

# Option 2: Individual components (recommended - auto-detects driver)
DB_SERVER=localhost
DB_DATABASE=document_analyzer
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_USE_WINDOWS_AUTH=False
DB_DRIVER=
AUTO_INIT_DB=True

# =============================================================================
# AWS Configuration
# =============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_REGION=us-east-1

# =============================================================================
# JWT Authentication Configuration
# =============================================================================
JWT_SECRET_KEY=dev-secret-key-change-in-production-minimum-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=15

# =============================================================================
# AI Services Configuration
# =============================================================================
# OpenAI API Key (required for document analysis)
OPENAI_API_KEY=your_openai_api_key

# Azure Cognitive Services (optional alternative to OpenAI)
AZURE_COGNITIVE_SERVICES_KEY=
AZURE_COGNITIVE_SERVICES_ENDPOINT=

# =============================================================================
# Application Configuration
# =============================================================================
APP_NAME=Document Analyzer Platform
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO
