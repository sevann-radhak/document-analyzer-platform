# Database Configuration
DATABASE_URL=sqlserver+pyodbc://username:password@localhost:1433/database_name?driver=ODBC+Driver+17+for+SQL+Server

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_REGION=us-east-1

# JWT Configuration
JWT_SECRET_KEY=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=15

# AI Service Configuration
# For OpenAI
OPENAI_API_KEY=your_openai_api_key

# For Azure Cognitive Services
AZURE_COGNITIVE_SERVICES_KEY=your_azure_key
AZURE_COGNITIVE_SERVICES_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# Application Configuration
APP_NAME=Document Analyzer Platform
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO
